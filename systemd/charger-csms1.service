[Unit]
Description=Charge System Management System 1
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/karl/source/Charger/CSMS
ExecStart=/usr/bin/python3 /home/karl/source/Charger/CSMS/csms.py --config /opt/charger/etc/csms1.config.yaml
Restart=on-failure
RestartSec=5
User=karl
Group=lovink

StandardOutput=file:/var/log/charger/csms1.stdout
StandardError=file:/var/log/charger/csms1.stderr

[Install]
WantedBy=multi-user.target
