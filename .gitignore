# Python bytecode / caches
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
venv/
env/

# SQLite databases (runtime data — never meant to be committed)
*.db
*.db-wal
*.db-shm
data/

# Logs
*.log
*.stdout
*.stderr
log/

# Editor / OS artifacts
*.swp
*.swo
*~
.DS_Store

# Local secrets, if ever used (not part of this project's config convention,
# but ignored defensively)
.env
